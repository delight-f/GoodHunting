<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GoodHunting.Tests</AssemblyName>
    <RootNamespace>GoodHunting.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Compiles the pure logic shared with the mod so the tests can run without the game
    installed. Everything under src/ is game-free except GoodHuntingModSystem, which is
    the only file that touches the game assemblies; new pure files are picked up
    automatically.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../src/**/*.cs" Exclude="../src/GoodHuntingModSystem.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The version Vintage Story 1.22.7 ships in Lib/, so the tests see the game's serialiser. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
