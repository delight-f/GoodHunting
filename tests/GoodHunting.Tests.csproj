<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>GoodHunting.Tests</AssemblyName>
    <RootNamespace>GoodHunting.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    Compiles the *pure* logic shared with the mod (no game assembly dependencies)
    so the tests can run anywhere without the game installed.
  -->
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../src/Data/Models.cs" />
    <Compile Include="../src/Data/GoodHuntingData.g.cs" />
    <Compile Include="../src/DropCategories.cs" />
    <Compile Include="../src/DropScaling.cs" />
    <Compile Include="../src/GoodHuntingConfig.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(VintageStoryDir)/Lib/Newtonsoft.Json.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <PropertyGroup>
    <VintageStoryDir Condition="'$(VintageStoryDir)' == ''">$(HOME)/.local/share/flatpak/app/at.vintagestory.VintageStory/x86_64/stable/active/files/extra/vintagestory</VintageStoryDir>
  </PropertyGroup>

</Project>
